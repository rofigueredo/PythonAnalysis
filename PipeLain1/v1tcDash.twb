      <column caption='SaldoItau' datatype='real' name='[Calculation_1455507106021281792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ fixed [FECHA_CIERRE]:&#13;&#10;    SUM(IF [Entidad] = [Parameters].[Parámetro 1] THEN [SaldoTC] END)&#13;&#10;}' />
      </column>
